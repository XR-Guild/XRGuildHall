# Build-time settings (copy to .env.local). public/guildhall.config.json overrides these at run time.
# None of these are secrets: they ship to every visitor.

# VIVERSE Studio App ID: VIVERSE login, the visitor's own VRM avatar, shared VIVERSE rooms
VITE_VIVERSE_APP_ID=
# People per VIVERSE room before an overflow room opens (keep <= VITE_PHOTON_MAX_PLAYERS)
VITE_VIVERSE_ROOM_CAP=20

# Photon Voice (dashboard.photonengine.com, app type Voice). Also copy the SDK into public/photon/ (see V3.md)
VITE_PHOTON_APP_ID=
VITE_PHOTON_REGION=us
# Match your Photon plan's CCU. The free plan is 20 (development only).
VITE_PHOTON_MAX_PLAYERS=20
# verified = Photon Custom Authentication with proxy/photon-auth-worker.js (recommended for public events)
# host     = the first person in the room acts as host
VITE_ADMIN_MODE=host

# LiveKit media room for stream screens and screenshare (proxy/media-token-worker.js). Video only.
VITE_MEDIA_TOKEN_URL=
VITE_MEDIA_ROOM=guild-hall-media

# Optional: library assistant answers (proxy/ask-worker.js)
VITE_ASK_PROXY=
