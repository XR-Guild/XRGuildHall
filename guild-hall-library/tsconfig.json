{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noImplicitAny": false, "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["vite/client", "webxr"], "noEmit": true, "isolatedModules": true
  },
  "include": ["src"]
}
